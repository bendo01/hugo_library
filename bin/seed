#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Usage: php bin/seed [authors [publishers [books]]]   (defaults: 10 5 30)
 */

$base = dirname(__DIR__);
require $base . '/vendor/autoload.php';

use Bendo01\HugoLibrary\Database\Database;
use Bendo01\HugoLibrary\Seeders\DatabaseSeeder;

Database::boot($base);

$counts = array_map('intval', array_slice($argv, 1, 3));
$seeder = new DatabaseSeeder(...$counts);

foreach ($seeder->run() as $table => $count) {
    echo "Seeded {$table}: {$count} new\n";
}
